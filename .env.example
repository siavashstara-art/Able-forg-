# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GITHUB_API_TOKEN: Optional token for authenticated GitHub remote operations.
GITHUB_API_TOKEN=MY_GITHUB_API_TOKEN

# PAYMENT_GATEWAY_API_KEY: Optional key for server-authoritative payment gateway verification.
PAYMENT_GATEWAY_API_KEY=MY_PAYMENT_GATEWAY_API_KEY
